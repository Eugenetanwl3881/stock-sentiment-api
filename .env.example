# Reddit Scraper — uses public .json endpoints, no API key needed
# Rate limit: ~10 requests/minute (plenty for daily polling)

# Database
# Quick testing (no setup):
# DATABASE_URL=sqlite:///./stock_sentiment.db

# Local Docker or production (port may vary if you have another Postgres running):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stocksentiment

# Scraper Settings
REDDIT_SUBREDDIT=valueinvesting
REDDIT_POST_LIMIT=100
REDDIT_SORT=hot

# Scheduler (runs daily at 08:00 UTC)
SCHEDULE_SCRAPE_HOUR=8
SCHEDULE_SCRAPE_MINUTE=0

# Server
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OpenCode Go — LLM-based ticker extraction (optional)
# Get your key at https://opencode.ai/auth
# OPENCODE_API_KEY=sk-...
# OPENCODE_MODEL=mimo-v2.5
# OPENCODE_ENABLED=false
